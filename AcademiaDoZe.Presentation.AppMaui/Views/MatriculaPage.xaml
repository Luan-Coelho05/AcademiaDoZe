<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             x:DataType="vm:MatriculaViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F4F6F9, Dark=#080D14}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
        <converters:DateOnlyToDateTimeConverter x:Key="DateOnlyConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20" MaximumWidthRequest="650" HorizontalOptions="Fill">

            <!-- Card 1: Aluno -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Aluno da Matrícula" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#E0F2FE, Dark=#0F2942}" StrokeShape="RoundRectangle 6" Padding="8,4" IsVisible="{Binding IsEditMode}">
                            <Label Text="{Binding Matricula.Id, StringFormat='ID: {0}'}" FontSize="12" TextColor="{AppThemeBinding Light=#0284C7, Dark=#38BDF8}" FontAttributes="Bold"/>
                        </Border>
                    </Grid>

                    <StackLayout Spacing="5">
                        <Label Text="CPF do Aluno" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B0F19}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#1E293B}" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <Entry Text="{Binding Matricula.AlunoMatricula.Cpf}" Placeholder="000.000.000-00" Keyboard="Numeric" MaxLength="14" ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding SearchByCpfCommand}"/>
                            </Border>
                            <Button Grid.Column="1" Text="Buscar" Command="{Binding SearchByCpfCommand}" BackgroundColor="#0284C7" TextColor="#FFFFFF" FontAttributes="Bold" CornerRadius="8" HeightRequest="42" Padding="18,0"/>
                        </Grid>
                    </StackLayout>

                    <!-- Aviso s/ aluno -->
                    <Border Padding="12" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#332701}" IsVisible="{Binding HasNoAlunoVinculado}">
                        <Label Text="Nenhum aluno selecionado. Digite o CPF acima e busque." TextColor="{AppThemeBinding Light=#92400E, Dark=#FCD34D}" FontSize="13"/>
                    </Border>

                    <!-- Resumo Aluno -->
                    <Border Padding="12" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F0FDF4, Dark=#052E16}" Stroke="#16A34A" IsVisible="{Binding HasAlunoVinculado}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15" VerticalOptions="Center">
                            <Border Grid.Column="0" HeightRequest="56" WidthRequest="56" StrokeShape="RoundRectangle 28" Stroke="#16A34A" StrokeThickness="2" BackgroundColor="Transparent">
                                <Image Source="{Binding Matricula.AlunoMatricula.Foto, Converter={StaticResource FotoToImageSourceConverter}}" Aspect="AspectFill" HeightRequest="56" WidthRequest="56"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Matricula.AlunoMatricula.Nome}" FontAttributes="Bold" FontSize="15" TextColor="#16A34A"/>
                                <Label Text="{Binding Matricula.AlunoMatricula.Cpf, StringFormat='CPF: {0}'}" FontSize="12"/>
                                <Label Text="{Binding Matricula.AlunoMatricula.DataNascimento, StringFormat='Nasc: {0:dd/MM/yyyy}'}" FontSize="12"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Padding="10" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#451A03}" IsVisible="{Binding IsMenor16}">
                        <Label Text="⚠ Aluno menor de 16 anos: laudo obrigatório." TextColor="{AppThemeBinding Light=#92400E, Dark=#FDE68A}" FontSize="12"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Card 2: Plano e Vigência -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="18">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Plano e Vigência" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Tipo de Plano" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B0F19}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#1E293B}" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <Picker x:Name="PlanoPicker" ItemsSource="{Binding PlanoTipos}" SelectedItem="{Binding Matricula.Plano}" SelectedIndexChanged="PlanoPicker_SelectedIndexChanged">
                                    <Picker.ItemDisplayBinding>
                                        <Binding Converter="{StaticResource EnumDisplay}"/>
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Início" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B0F19}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#1E293B}" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <DatePicker x:Name="InicioDatePicker" Format="dd/MM/yyyy" Date="{Binding Matricula.DataInicio, Converter={StaticResource DateOnlyConverter}, Mode=TwoWay}" DateSelected="InicioDatePicker_DateSelected"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Label Text="Término" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B0F19}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#1E293B}" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <DatePicker x:Name="FimDatePicker" Format="dd/MM/yyyy" Date="{Binding Matricula.DataFim, Converter={StaticResource DateOnlyConverter}, Mode=TwoWay}" IsEnabled="False"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <StackLayout Spacing="5">
                        <Label Text="Objetivo" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B0F19}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#1E293B}" StrokeShape="RoundRectangle 8" Padding="10,0">
                            <Entry Text="{Binding Matricula.Objetivo}" Placeholder="Ex: Hipertrofia..." MaxLength="200"/>
                        </Border>
                    </StackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Card 3: Restrições -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Condições e Restrições" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>

                    <CollectionView ItemsSource="{Binding RestricoesMulti}" SelectionMode="None" HeightRequest="150">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="2"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RestricaoSelectable">
                                <Grid ColumnDefinitions="Auto,*" Padding="0,4">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"/>
                                    <Label Grid.Column="1" Text="{Binding Value, Converter={StaticResource EnumDisplay}}" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <StackLayout Spacing="5">
                        <Label Text="Observações" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B0F19}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#1E293B}" StrokeShape="RoundRectangle 8" Padding="10,0">
                            <Entry Text="{Binding Matricula.ObservacoesRestricoes}" Placeholder="Cuidados..." MaxLength="500"/>
                        </Border>
                    </StackLayout>

                    <Border Padding="10" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#451A03}" IsVisible="{Binding HasRestricoes}">
                        <Label Text="⚠ Restrições marcadas exigem laudo." TextColor="{AppThemeBinding Light=#92400E, Dark=#FDE68A}" FontSize="12"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Card 4: Laudo -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Laudo Médico" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        <Border Grid.Column="1" Padding="8,4" StrokeShape="RoundRectangle 6" BackgroundColor="{AppThemeBinding Light=#DCFCE7, Dark=#064E3B}" IsVisible="{Binding HasLaudo}">
                            <Label Text="✓ Anexado" FontSize="11" TextColor="{AppThemeBinding Light=#166534, Dark=#86EFAC}" FontAttributes="Bold"/>
                        </Border>
                        <Border Grid.Column="1" Padding="8,4" StrokeShape="RoundRectangle 6" BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#7F1D1D}" IsVisible="{Binding LaudoPendente}">
                            <Label Text="Obrigatório" FontSize="11" TextColor="{AppThemeBinding Light=#991B1B, Dark=#FCA5A5}" FontAttributes="Bold"/>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                        <Border Grid.Column="0" HeightRequest="100" WidthRequest="100" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B0F19}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#1E293B}">
                            <Image Source="{Binding Matricula.LaudoMedico, Converter={StaticResource FotoToImageSourceConverter}}" Aspect="AspectFill" HeightRequest="100" WidthRequest="100" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Button Text="Selecionar Imagem" Command="{Binding SelecionarFotoCommand}" BackgroundColor="#0284C7" TextColor="#FFFFFF" FontAttributes="Bold" CornerRadius="8" HeightRequest="42" Padding="12,0"/>
                            <Button Text="Remover Laudo" Command="{Binding RemoverLaudoCommand}" BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#2D1215}" TextColor="{AppThemeBinding Light=#EF4444, Dark=#F87171}" BorderColor="{AppThemeBinding Light=#FECACA, Dark=#451A1F}" BorderWidth="1" CornerRadius="8" FontAttributes="Bold" HeightRequest="42" Padding="12,0" IsVisible="{Binding HasLaudo}"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Ações -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,20">
                <Button Grid.Column="0" Text="Cancelar" Command="{Binding CancelCommand}" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#334155}" BorderWidth="1" FontAttributes="Bold" CornerRadius="8" HeightRequest="46"/>
                <Button Grid.Column="1" Text="Salvar" Command="{Binding SaveMatriculaCommand}" BackgroundColor="#0284C7" TextColor="#FFFFFF" FontAttributes="Bold" CornerRadius="8" HeightRequest="46"/>
            </Grid>

            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="#0284C7" VerticalOptions="Center" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>